<Window
    x:Class="IDCLogChecker.Avalonia.MainWindow"
    x:DataType="local:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IDCLogChecker.Avalonia"
    xmlns:presentation="using:IDCLogChecker.Core.Presentation"
    Title="IDC 日志完整性检查工具"
    Width="1280" Height="840" MinWidth="1080" MinHeight="720"
    WindowStartupLocation="CenterScreen"
    DragDrop.AllowDrop="True"
    DragDrop.DragEnter="OnDragEnter" DragDrop.DragLeave="OnDragLeave"
    DragDrop.DragOver="OnDragOver" DragDrop.Drop="OnDrop">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Background="#14213D" Padding="28,20">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
        <StackPanel Spacing="5">
          <TextBlock FontSize="25" FontWeight="Bold" Foreground="White" Text="IDC 日志完整性检查工具" />
          <TextBlock Foreground="#C6D5E4" Text="可选择或拖入多个巡检结果目录，逐个核对并分别展示结果" />
        </StackPanel>
        <Border Grid.Column="1" Background="#23385D" CornerRadius="8" Padding="18,10">
          <TextBlock Foreground="White" FontWeight="SemiBold" Text="基准：62 个设备目录 · 3,660 个 TXT" />
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="22" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
      <Border x:Name="DropZone" Grid.Row="0" Classes="card" BorderThickness="2"
              >
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
          <StackPanel Spacing="3" VerticalAlignment="Center">
            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#14213D" Text="{Binding SelectionSummaryText}" />
            <TextBlock FontSize="12" Foreground="#60758A" Text="{Binding InputNoticeText}" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1" Classes="secondary" Click="OnChooseFolderClick" Content="选择多个文件夹…" />
          <Button Grid.Column="2" Classes="primary" Click="OnStartScanClick" Content="开始检查" IsEnabled="{Binding CanStart}" />
        </Grid>
      </Border>

      <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12">
        <Border Classes="card"><StackPanel Spacing="4"><TextBlock Foreground="#60758A" Text="本批次文件夹" /><TextBlock FontSize="22" FontWeight="Bold" Foreground="#14213D" Text="{Binding TotalFolderCountText}" /></StackPanel></Border>
        <Border Grid.Column="1" Classes="card"><StackPanel Spacing="4"><TextBlock Foreground="#60758A" Text="完全通过" /><TextBlock FontSize="22" FontWeight="Bold" Foreground="#1F8A70" Text="{Binding CleanFolderCountText}" /></StackPanel></Border>
        <Border Grid.Column="2" Classes="card"><StackPanel Spacing="4"><TextBlock Foreground="#60758A" Text="无法确认" /><TextBlock FontSize="22" FontWeight="Bold" Foreground="#7D5BA6" Text="{Binding IndeterminateFolderCountText}" /></StackPanel></Border>
        <Border Grid.Column="3" Classes="card"><StackPanel Spacing="4"><TextBlock Foreground="#60758A" Text="有提示" /><TextBlock FontSize="22" FontWeight="Bold" Foreground="#D78C12" Text="{Binding WarningFolderCountText}" /></StackPanel></Border>
        <Border Grid.Column="4" Classes="card"><StackPanel Spacing="4"><TextBlock Foreground="#60758A" Text="不通过" /><TextBlock FontSize="22" FontWeight="Bold" Foreground="#C0392B" Text="{Binding FailedFolderCountText}" /></StackPanel></Border>
      </Grid>

      <Grid Grid.Row="2" ColumnDefinitions="*,220" ColumnSpacing="14">
        <TextBlock Foreground="#52697D" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
        <ProgressBar Grid.Column="1" Height="7" Maximum="100" Value="{Binding ProgressPercent}" />
      </Grid>

      <Grid Grid.Row="3" ColumnDefinitions="310,*" ColumnSpacing="12" MinHeight="390">
        <Border Classes="card" Padding="0">
          <Grid RowDefinitions="Auto,*">
            <Border Background="#EAF0F5" Padding="16,12">
              <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#14213D" Text="文件夹检查结果" />
            </Border>
            <DataGrid Grid.Row="1" ItemsSource="{Binding FolderResults}" SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                      SelectionChanged="OnFolderSelectionChanged" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserResizeColumns="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="文件夹" Width="190" MinWidth="110">
                  <DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="local:FolderResultViewModel"><TextBlock Margin="8,5" FontWeight="SemiBold" Text="{Binding FolderName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FolderName}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="结果" Width="90" MinWidth="70">
                  <DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="local:FolderResultViewModel"><TextBlock Margin="8,5" FontWeight="SemiBold" Foreground="{Binding StatusColor}" Text="{Binding StatusText}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="错误" Binding="{Binding ErrorCount}" Width="65" MinWidth="55" />
                <DataGridTextColumn Header="无法确认" Binding="{Binding IndeterminateCount}" Width="82" MinWidth="70" />
                <DataGridTextColumn Header="提示" Binding="{Binding WarningCount}" Width="65" MinWidth="55" />
                <DataGridTemplateColumn Header="完整路径" Width="360" MinWidth="180">
                  <DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="local:FolderResultViewModel"><TextBlock Margin="8,5" Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>

        <Border Grid.Column="1" Classes="card" Padding="0">
          <Grid RowDefinitions="Auto,Auto,*,Auto">
            <Grid Margin="16,13" ColumnDefinitions="2*,*,*,*,*,*" ColumnSpacing="10">
              <StackPanel Spacing="3"><TextBlock FontSize="11" Foreground="#60758A" Text="当前文件夹结论" /><TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{Binding StatusColor}" Text="{Binding Conclusion}" TextWrapping="Wrap" /></StackPanel>
              <StackPanel Grid.Column="1" Spacing="3"><TextBlock FontSize="11" Foreground="#60758A" Text="设备目录" /><TextBlock FontSize="18" FontWeight="Bold" Text="{Binding DirectoryCountText}" /></StackPanel>
              <StackPanel Grid.Column="2" Spacing="3"><TextBlock FontSize="11" Foreground="#60758A" Text="TXT 文件" /><TextBlock FontSize="18" FontWeight="Bold" Text="{Binding TxtCountText}" /></StackPanel>
              <StackPanel Grid.Column="3" Spacing="3"><TextBlock FontSize="11" Foreground="#60758A" Text="错误" /><TextBlock FontSize="18" FontWeight="Bold" Foreground="#C0392B" Text="{Binding ErrorCountText}" /></StackPanel>
              <StackPanel Grid.Column="4" Spacing="3"><TextBlock FontSize="11" Foreground="#60758A" Text="无法确认" /><TextBlock FontSize="18" FontWeight="Bold" Foreground="#7D5BA6" Text="{Binding IndeterminateCountText}" /></StackPanel>
              <StackPanel Grid.Column="5" Spacing="3"><TextBlock FontSize="11" Foreground="#60758A" Text="提示" /><TextBlock FontSize="18" FontWeight="Bold" Foreground="#D78C12" Text="{Binding WarningCountText}" /></StackPanel>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="14,0,14,10">
              <StackPanel Spacing="5">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Button Classes="secondary" Click="OnShowAllClick" Content="全部" />
                  <Button Classes="secondary" Click="OnShowErrorsClick" Content="只看错误" />
                  <Button Classes="secondary" Click="OnShowIndeterminateClick" Content="只看无法确认" />
                  <Button Classes="secondary" Click="OnShowWarningsClick" Content="只看提示" />
                </StackPanel>
                <TextBlock FontSize="11" Foreground="#60758A">
                  <Run Text="内容确认正常 " /><Run FontWeight="SemiBold" Text="{Binding ContentNormalCountText}" />
                  <Run Text=" · 暂未配置内容规则 " /><Run FontWeight="SemiBold" Text="{Binding UnsupportedContentRuleCountText}" />
                  <Run Text=" · 可拖动表头分隔线调整列宽" />
                </TextBlock>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
                <Button Classes="secondary" Click="OnCopyClick" Content="复制明细" />
                <Button Classes="secondary" Click="OnOpenLocationClick" Content="打开位置" />
                <Button Classes="secondary" Click="OnExportCurrentClick" Content="导出当前" IsEnabled="{Binding CanExportCurrent}" />
                <Button Classes="primary" Click="OnExportAllClick" Content="导出全部" IsEnabled="{Binding CanExportAll}" />
              </StackPanel>
            </Grid>

            <DataGrid x:Name="IssueList" Grid.Row="2" Margin="14,0" ItemsSource="{Binding VisibleIssues}"
                      SelectionChanged="OnIssueSelectionChanged" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserResizeColumns="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="#D7E0E8" BorderThickness="1">
              <DataGrid.Columns>
                <DataGridTextColumn Header="级别" Binding="{Binding SeverityText}" Width="85" MinWidth="70" />
                <DataGridTemplateColumn Header="问题类型" Width="180" MinWidth="120"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="presentation:IssueRow"><TextBlock Margin="8,5" Text="{Binding CategoryText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CategoryText}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="设备目录" Width="240" MinWidth="140"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="presentation:IssueRow"><TextBlock Margin="8,5" Text="{Binding DeviceName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DeviceName}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="TXT 文件" Width="240" MinWidth="140"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="presentation:IssueRow"><TextBlock Margin="8,5" FontFamily="Consolas, monospace" FontSize="11" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileName}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="说明" Width="380" MinWidth="220"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="presentation:IssueRow"><TextBlock Margin="8,5" Text="{Binding Message}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Message}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="实际内容" Width="300" MinWidth="180"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="presentation:IssueRow"><TextBlock Margin="8,5" Text="{Binding Actual}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Actual}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="完整路径" Width="420" MinWidth="220"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="presentation:IssueRow"><TextBlock Margin="8,5" Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="3" Background="#F7F9FB" BorderBrush="#D7E0E8" BorderThickness="0,1,0,0" Padding="14,10">
              <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto">
                <SelectableTextBlock x:Name="IssueDetail" Foreground="#34495E" Text="选择一条明细，可在这里查看完整说明。" TextWrapping="Wrap" />
              </ScrollViewer>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
